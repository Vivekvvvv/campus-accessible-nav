{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:gen": "node tools/generate-openapi-types.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test tests/navigation.spec.js",
    "test:e2e:hazard-edge": "playwright test tests/navigation.spec.js --grep \"Navigation Hazard Edge Cases\"",
    "i18n:check": "node tools/check-i18n-keys.mjs",
    "lint": "eslint .",
    "perf:budget": "node tools/check-bundle-budget.mjs",
    "lint:report": "eslint . --format json -o reports/eslint-report.json",
    "deps:check": "depcheck --json --ignore-patterns=dist,playwright-report,test-results,reports --ignores=@pinia/testing,@tailwindcss/postcss,@vitest/coverage-v8,@vue/test-utils,autoprefixer,openapi-typescript,postcss,tailwindcss",
    "cleanup:report": "node tools/generate-cleanup-report.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.15.0",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.26.0",
    "vue": "^3.5.24",
    "vue-i18n": "^9.9.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@pinia/testing": "^0.1.3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "depcheck": "^1.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
