# Copy to .env, then run: docker compose up -d --build
# Also used by: start.ps1 (reads ports + POSTGRES_* defaults)

# Host port mapping (change if you have conflicts)
FRONTEND_PORT=5173
BACKEND_PORT=8081
POSTGRES_PORT=5432

# Backend profile(s)
# - dev: local PostgreSQL + PostGIS baseline
# - docker: defaults suitable for docker-compose (minimal actuator exposure)
# - prod: disable Swagger/OpenAPI and tighten health details
# - h2: run without PostgreSQL (demo/smoke only; limited features)
# Leave empty to use base defaults (equivalent to local dev baseline).
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL / PostGIS (docker-compose.yml uses these)
# NOTE: PostGIS is REQUIRED (Flyway migration V1 enables it via: CREATE EXTENSION IF NOT EXISTS postgis;)
POSTGRES_DB=accessible_nav
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# App/scripts DB connection (for start.ps1 + scripts/backup.sh & scripts/restore.sh when running outside compose)
# If DB_URL is not set, backend will compose it from these values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accessible_nav
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=postgres

# Initial admin account for backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT secret (MUST be changed in production)
JWT_SECRET=dev-secret-change-me-please-32-chars

# Log format: json | plain
LOG_FORMAT=json

# Frontend auth guard (milliseconds)
# - checks protected route token validity periodically
# - min 5000; default fallback 15000
VITE_AUTH_GUARD_INTERVAL_MS=15000

# Frontend JWT skew seconds
# - treat token as expired slightly earlier to avoid edge-case 401/403
VITE_AUTH_TOKEN_SKEW_SECONDS=90

# Frontend session expiry warning (minutes)
# - show top warning before token expiration
VITE_AUTH_EXPIRY_WARNING_MINUTES=10

# Frontend session expiry warning snooze (minutes)
VITE_AUTH_EXPIRY_WARNING_SNOOZE_MINUTES=5

# Frontend critical warning pulse animation (true/false)
VITE_AUTH_EXPIRY_CRITICAL_PULSE_ENABLED=true

# Optional explicit JDBC URL (overrides DB_HOST/DB_PORT/DB_NAME composition)
# DB_URL=jdbc:postgresql://localhost:5432/accessible_nav?currentSchema=public

# Actuator health details visibility (production-safe default)
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never

# Actuator endpoints exposure (tighten in production)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus

# Rate limiting (prod should use Redis-backed mode)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_USE_REDIS=false

# Obstacle dedupe switch (set false for troubleshooting and comparison drills)
OBSTACLE_DEDUPE_ENABLED=true

# PR-17 passability dynamic weight defaults (can be overridden per-tenant via admin API)
ROUTING_PASSABILITY_PENALTY_ENABLED=true
ROUTING_PASSABILITY_MIN_CLAMP=0.01
ROUTING_PASSABILITY_WEIGHT_FACTOR=1.0

# Optional: import graph data on startup (GraphImportRequest JSON)
# GRAPH_IMPORT_PATH=/data/gbuc-jianggao/graph-import.json

# Trace query integration (for scripts/ops/open-trace-query.ps1)
# Choose one provider: kibana | loki
TRACE_QUERY_PROVIDER=kibana
# Optional highest-priority override template:
TRACE_QUERY_URL_TEMPLATE=

# Team standard template (Kibana Discover).
# Supported placeholders: {traceId} {service} {fromIso} {toIso} {traceIdUrl} {serviceUrl} {fromIsoUrl} {toIsoUrl}
TRACE_QUERY_URL_TEMPLATE_KIBANA=https://kibana.example/app/discover#/?_a=%28query:%28language:kuery,query:%27traceId:{traceId}%20and%20service.name:{service}%27%29%29&_g=%28time:%28from:%27{fromIso}%27,to:%27{toIso}%27%29%29

# Team standard template (Grafana Loki Explore).
TRACE_QUERY_URL_TEMPLATE_LOKI=https://grafana.example/explore?left=%7B%22datasource%22%3A%22Loki%22%2C%22queries%22%3A%5B%7B%22expr%22%3A%22%7Bapp%3D%5C%22{service}%5C%22%7D%20%7C%3D%20%5C%22{traceId}%5C%22%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22{fromIso}%22%2C%22to%22%3A%22{toIso}%22%7D%7D
